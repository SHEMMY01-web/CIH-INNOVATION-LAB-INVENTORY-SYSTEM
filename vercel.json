{
  "cleanUrls": true,
  "redirects": [
    { "source": "/FRONTEND/HTML/index", "destination": "/" },
    { "source": "/FRONTEND/HTML/index.html", "destination": "/" },
    { "source": "/index.html", "destination": "/" },
    { "source": "/index", "destination": "/" },
    { "source": "/FRONTEND/HTML/(.*)", "destination": "/$1" }
  ],
  "rewrites": [
    { "source": "/", "destination": "/FRONTEND/HTML/index" },
    { "source": "/assets", "destination": "/FRONTEND/HTML/assets" },
    { "source": "/dashboard", "destination": "/FRONTEND/HTML/dashboard" },
    { "source": "/enter_otp", "destination": "/FRONTEND/HTML/enter_otp" },
    { "source": "/forgot_password", "destination": "/FRONTEND/HTML/forgot_password" },
    { "source": "/grn_report", "destination": "/FRONTEND/HTML/grn_report" },
    { "source": "/items", "destination": "/FRONTEND/HTML/items" },
    { "source": "/login_successful", "destination": "/FRONTEND/HTML/login_successful" },
    { "source": "/project", "destination": "/FRONTEND/HTML/project" },
    { "source": "/project_detail", "destination": "/FRONTEND/HTML/project_detail" },
    { "source": "/request", "destination": "/FRONTEND/HTML/request" },
    { "source": "/tools", "destination": "/FRONTEND/HTML/tools" }
  ]
}
