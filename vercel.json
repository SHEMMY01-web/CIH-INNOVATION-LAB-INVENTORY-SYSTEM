{
  "cleanUrls": true,
  "redirects": [
    {
      "source": "/FRONTEND/HTML/:file",
      "destination": "/:file",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/",
      "destination": "/FRONTEND/HTML/index.html"
    },
    {
      "source": "/:file",
      "destination": "/FRONTEND/HTML/:file"
    }
  ]
}
